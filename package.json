{
  "name": "signudoc",
  "version": "0.7.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p3010",
    "dev:secure": "next dev -p 3010 --experimental-https",
    "build": "next build",
    "start": "next start -p3010",
    "db:start": "docker compose up -d --wait db && node db/migrate.mjs",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && node db/migrate.mjs",
    "db:migrate": "node db/migrate.mjs",
    "auth:generate": "auth generate --config ./src/lib/auth/better-auth.config.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "lint": "biome check",
    "format": "biome check --write --linter-enabled=false",
    "format:check": "biome check",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\" \"db/**/*.test.mjs\"",
    "restore-backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/restore-backup.ts",
    "test:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 \"src/**/*.dbtest.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@signpdf/placeholder-pdf-lib": "4.0.0",
    "@signpdf/signer-p12": "4.0.0",
    "@signpdf/signpdf": "4.0.0",
    "@signpdf/utils": "4.0.0",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "better-auth": "^1.7.27",
    "botid": "^1.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "harfbuzzjs": "1.6.4",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "node-forge": "1.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.39.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/node-forge": "1.3.14",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.5",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "$zod"
    }
  }
}
